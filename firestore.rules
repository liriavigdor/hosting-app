rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // חוקים קבועים ללא תאריך תפוגה וללא הגבלת 30 יום
    // מאפשר תפקוד מלא ורציף של האפליקציה: הזמנות, מוצרים, הגדרות וביקורות
    match /products/{docId} {
      allow read, write: if true;
    }

    match /orders/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /reviews/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

